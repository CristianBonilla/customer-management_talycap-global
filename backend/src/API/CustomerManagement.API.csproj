<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CustomerManagement.API</RootNamespace>
    <AssemblyName>CustomerManagement.API</AssemblyName>
    <!-- Genera XML para Swagger XML comments -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\CustomerManagement.Application.csproj" />
    <ProjectReference Include="..\Contracts\CustomerManagement.Contracts.csproj" />
    <ProjectReference Include="..\Infrastructure\CustomerManagement.Infrastructure.csproj" />
  </ItemGroup>

</Project>
